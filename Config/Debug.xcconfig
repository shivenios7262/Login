#include "Pods/Target Support Files/Pods-LOGIN/Pods-LOGIN.debug.xcconfig"

// Debug environment configuration.
//
// SECURITY: Add this file to .gitignore if it contains real credentials.
// Current values are test/dev credentials — safe for VCS while they remain test-only.
//
// This xcconfig is assigned as the base configuration for the Debug build configuration.
// Values here are substituted into Config/Info.plist at build time via $(VAR_NAME) syntax.

// Override INFOPLIST_FILE to point to Config/Info.plist (outside the file-system-synchronized
// group) so it isn't also copied as a bundle resource, which would cause a build conflict.
INFOPLIST_FILE = Config/Info.plist
ENABLE_USER_SCRIPT_SANDBOXING = NO

// xcconfig treats // as a comment, so use $(SLASH) to embed // in a URL value.
SLASH = /
APP_API_BASE_URL = http:$(SLASH)$(SLASH)13.200.42.214
APP_TYPE = 1
APP_USER = ftdiostest
APP_PASSWORD = 123456
APP_VERSION = 1.0
