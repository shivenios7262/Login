#include "Pods/Target Support Files/Pods-LOGIN/Pods-LOGIN.release.xcconfig"

// Staging / TestFlight configuration.
// Uses release-mode optimisations but points at the staging/dev server.
// Assigned as the base configuration for the Staging build configuration.
// TODO: Replace APP_API_BASE_URL with your actual staging server URL when available.

INFOPLIST_FILE = Config/Info.plist
ENABLE_USER_SCRIPT_SANDBOXING = NO

// xcconfig treats // as a comment, so use $(SLASH) to embed // in a URL value.
SLASH = /
APP_ENV = staging
APP_DISPLAY_NAME = FTD Travel'S
APP_API_BASE_URL = http:$(SLASH)$(SLASH)13.200.42.214
APP_TYPE = 1
APP_USER = ftdiostest
APP_PASSWORD = 123456
APP_VERSION = 1.0
APP_OTP_TIMEZONE = UTC
