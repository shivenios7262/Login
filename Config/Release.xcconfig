#include "Pods/Target Support Files/Pods-LOGIN/Pods-LOGIN.release.xcconfig"

// Release / App Store production configuration.
// SECURITY: Consider gitignoring this file once production credentials are finalised.
// For CI: inject secrets via environment variables before archiving.

INFOPLIST_FILE = Config/Info.plist
ENABLE_USER_SCRIPT_SANDBOXING = NO

// xcconfig treats // as a comment, so use $(SLASH) to embed // in a URL value.
SLASH = /
APP_ENV = production
APP_DISPLAY_NAME = FTD Travel
APP_TYPE = 1

// --- App Store (production) values ---
APP_API_BASE_URL = https:$(SLASH)$(SLASH)www.ftd.travel
APP_USER = ftdtravel_ios_2026_sep
APP_PASSWORD = Mr&i8&FtFtmMh7jYoBB5k#@ff3egXTRAQBPKdALr
APP_VERSION = 1.1.1
APP_OTP_TIMEZONE = IST

// --- TestFlight (dev/staging) values — picked at runtime when sandboxReceipt is detected ---
APP_API_STAGING_URL = http:$(SLASH)$(SLASH)13.200.42.214
APP_STAGING_USER = ftdiostest
APP_STAGING_PASSWORD = 123456
APP_STAGING_VERSION = 1.0
APP_STAGING_OTP_TIMEZONE = UTC
