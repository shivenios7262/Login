// Release / production configuration template.
//
// SETUP: Copy this file to Config/Release.xcconfig and fill in production values.
// Config/Release.xcconfig is gitignored — never commit production credentials.
//
// CI usage — populate before archiving:
//   cp Config/Release.xcconfig.example Config/Release.xcconfig
//   sed -i '' "s/<YOUR_PROD_SERVER>/real.domain.com/" Config/Release.xcconfig
//   sed -i '' "s/<YOUR_APP_USER>/$FTD_PROD_APP_USER/" Config/Release.xcconfig
//   sed -i '' "s/<YOUR_APP_PASSWORD>/$FTD_PROD_APP_PASSWORD/" Config/Release.xcconfig

INFOPLIST_FILE = Config/Info.plist

SLASH = /
APP_API_BASE_URL = https:$(SLASH)$(SLASH)<YOUR_PROD_SERVER>
APP_TYPE = 1
APP_USER = <YOUR_APP_USER>
APP_PASSWORD = <YOUR_APP_PASSWORD>
APP_VERSION = 1.0
