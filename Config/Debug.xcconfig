#include "Pods/Target Support Files/Pods-LOGIN/Pods-LOGIN.debug.xcconfig"

// Debug environment configuration — dev server, test credentials.
// Safe for VCS while these remain test-only values.
// Assigned as the base configuration for the Debug build configuration.

INFOPLIST_FILE = Config/Info.plist
ENABLE_USER_SCRIPT_SANDBOXING = NO

// xcconfig treats // as a comment, so use $(SLASH) to embed // in a URL value.
SLASH = /
APP_ENV = debug
APP_DISPLAY_NAME = FTD Travel'D
APP_API_BASE_URL = http:$(SLASH)$(SLASH)13.200.42.214
APP_TYPE = 1
APP_USER = ftdiostest
APP_PASSWORD = 123456
APP_VERSION = 1.0
APP_OTP_TIMEZONE = UTC
