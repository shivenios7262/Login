// Debug environment configuration template.
//
// SETUP: Copy this file to Config/Debug.xcconfig and fill in real values.
// Config/Debug.xcconfig is gitignored — never commit actual credentials.
//
// Assign Config/Debug.xcconfig as the base configuration for the Debug build
// configuration in Xcode: Project → Info → Configurations.

INFOPLIST_FILE = Config/Info.plist

// xcconfig treats // as a comment, so use $(SLASH) to embed // in a URL value.
SLASH = /
APP_API_BASE_URL = http:$(SLASH)$(SLASH)<YOUR_DEV_SERVER_IP_OR_DOMAIN>
APP_TYPE = 1
APP_USER = <YOUR_APP_USER>
APP_PASSWORD = <YOUR_APP_PASSWORD>
APP_VERSION = 1.0
